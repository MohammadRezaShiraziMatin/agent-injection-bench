{
  "terminal.integrated.defaultProfile.windows": "OpenClaw (WSL login shell)",
  "terminal.integrated.profiles.windows": {
    "WSL": {
      "source": "WSL",
      "icon": "terminal-linux"
    },
    "OpenClaw (WSL login shell)": {
      "path": "C:\\Windows\\System32\\wsl.exe",
      "args": ["-e", "bash", "-l"],
      "icon": "terminal-linux"
    }
  },
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.automationProfile.windows": {
    "path": "C:\\Windows\\System32\\wsl.exe",
    "args": ["-e", "bash", "-lc", "export PATH=\"$HOME/.openclaw/bin:$PATH\"; exec bash -l"]
  },
  "terminal.integrated.env.linux": {
    "PATH": "${workspaceFolder}/.bin:${env:HOME}/.openclaw/bin:${env:PATH}"
  },
  "terminal.integrated.env.osx": {
    "PATH": "${workspaceFolder}/.bin:${env:HOME}/.openclaw/bin:${env:PATH}"
  }
}
