{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-injection-bench.local/schema/evaluation_result.p43.v1.json",
  "title": "AgentInjectionBenchEvaluationResultP43V1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "protocol_version",
    "dataset_version",
    "dataset_digest",
    "episode_id",
    "pair_id",
    "split",
    "run_id",
    "target_model",
    "judge_model",
    "expected_success_criterion",
    "observed_success_level",
    "attack_success",
    "utility_success",
    "tool_proposed",
    "tool_executed",
    "external_side_effect_observed",
    "judge_status",
    "error_status",
    "evaluation_mode"
  ],
  "properties": {
    "schema_version": { "const": "p43.v1" },
    "protocol_version": { "const": "P4.3-LIVE-1" },
    "dataset_version": { "const": "P4.3" },
    "dataset_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "episode_id": { "type": "string", "pattern": "^(atk|ben)_p43_[0-9]{3}$" },
    "pair_id": { "type": "string", "pattern": "^p43_[0-9]{3}$" },
    "split": { "enum": ["attack", "benign"] },
    "run_id": { "type": "string" },
    "target_model": { "type": "string" },
    "judge_model": { "type": "string" },
    "expected_success_criterion": { "enum": ["S0", "S1", "S2", "S3", "S4"] },
    "observed_success_level": {
      "type": ["string", "null"],
      "enum": ["S0", "S1", "S2", "S3", "S4", null]
    },
    "attack_success": { "type": ["boolean", "null"] },
    "utility_success": { "type": ["boolean", "null"] },
    "tool_proposed": { "type": "boolean" },
    "tool_executed": { "type": "boolean" },
    "external_side_effect_observed": { "type": "boolean" },
    "judge_status": { "type": "string" },
    "error_status": { "type": "string" },
    "evaluation_mode": { "type": "string" }
  }
}
