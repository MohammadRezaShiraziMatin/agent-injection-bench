# Copy to .env for local runs:  cp .env.example .env
# Then set AIB_LLM_API_KEY (or OPENAI_API_KEY below). .env is gitignored.
# Project-specific names take precedence over OPENAI_* fallbacks.
# Never commit API keys or paste them into git, issues, or traces.

AIB_LLM_API_KEY=
AIB_LLM_BASE_URL=https://api.openai.com/v1
AIB_LLM_MODEL=gpt-4o-mini

# Used only when the matching AIB_* variable is unset:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional (names only — never put real secrets here)
# AIB_LLM_MAX_STEPS=6
# AIB_LLM_TIMEOUT_SEC=60
# AIB_LLM_TEMPERATURE=0
# AIB_LLM_SEED=
#   Note: seed is best-effort. Configuring a seed does NOT guarantee
#   deterministic execution across providers or API versions.

# Phase C matrix (see PHASE_C.md). Full matrix is costly.
# MODELS=gpt-4o-mini,gpt-4o
# BASELINES=d0,d1
# K=3
# AIB_PHASE_C_SMOKE_ONLY=1
# AIB_PROMPT_ID=d0
