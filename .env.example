# Copy to .env and fill in. Never commit real keys.

# --- Default OpenAI-compatible harness ---
AIB_LLM_API_KEY=
AIB_LLM_BASE_URL=https://api.openai.com/v1
AIB_LLM_MODEL=gpt-4o-mini

# --- OpenRouter (P4.3 live-eval lock; must match config/p4_3_live_eval_gate.v1.json) ---
# AIB_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TARGET_MODEL=openai/gpt-4o-mini-2024-07-18
OPENROUTER_JUDGE_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_ALLOW_FALLBACKS=false
OPENROUTER_TARGET_PROVIDER_ORDER=OpenAI
OPENROUTER_JUDGE_PROVIDER_ORDER=Groq

# Fallback used only if AIB_LLM_API_KEY / OPENROUTER_API_KEY empty:
# OPENAI_API_KEY=
